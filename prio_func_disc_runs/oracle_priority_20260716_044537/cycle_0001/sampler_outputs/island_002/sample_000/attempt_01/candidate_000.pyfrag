def priority_v2(training_data, ancestry_coordinate, target_variant) -> float:
    try:
        n = 8
        radii_effects = effect_size_by_cumulative_radius(
            training_data,
            ancestry_coordinate,
            target_variant,
            n,
        )
        radii_entropy = dosage_entropy_by_cumulative_radius(
            training_data,
            ancestry_coordinate,
            target_variant,
            n,
        )
        usable_radius, usable_min = minimum_radius_for_sample_count(
            training_data,
            ancestry_coordinate,
            target_variant,
            25,
        )
    except Exception:
        return 0.0

    if not radii_effects:
        return 0.0

    if usable_min <= 0:
        return 0.0

    best_index = 0
    best_score = None

    for i, (radius, effect) in enumerate(radii_effects):
        entropy = radii_entropy[i][1] if i < len(radii_entropy) else 0.0
        next_effect = radii_effects[i + 1][1] if i + 1 < len(radii_effects) else effect

        effect_change = abs(next_effect - effect)
        effect_magnitude = abs(effect)

        score = (
            1.5 * entropy
            + 0.7 * effect_magnitude
            - 1.2 * effect_change
            + 0.15 * radius
        )

        if radius < usable_radius:
            score -= 1.0

        if best_score is None or score > best_score:
            best_score = score
            best_index = i

    chosen_radius = radii_effects[best_index][0]

    if chosen_radius < usable_radius:
        chosen_radius = usable_radius

    if not (chosen_radius >= 0.0):
        return 0.0

    return float(chosen_radius)