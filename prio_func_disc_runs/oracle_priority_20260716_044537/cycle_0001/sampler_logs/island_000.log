    try:
        radii_effects = effect_size_by_cumulative_radius(
            training_data,
            ancestry_coordinate,
            target_variant,
            8,
        )
        entropy_pairs = dosage_entropy_by_cumulative_radius(
            training_data,
            ancestry_coordinate,
            target_variant,
            8,
        )
        min_radius, effective_min_samples = minimum_radius_for_sample_count(
            training_data,
            ancestry_coordinate,
            target_variant,
            25,
        )
    except Exception:
        return 0.0

    if not radii_effects:
        return 0.0

    usable = []
    for i, (radius, effect) in enumerate(radii_effects):
        entropy = entropy_pairs[i][1] if i < len(entropy_pairs) else 0.0
        score = abs(effect) * (1.0 + entropy)
        if radius >= min_radius:
            score *= 1.15
        if i > 0:
            prev_effect = radii_effects[i - 1][1]
            score += 0.5 * abs(effect - prev_effect)
        usable.append((radius, score))

    best_radius = max(usable, key=lambda x: x[1])[0]

    if effective_min_samples <= 0:
        return 0.0

    if min_radius > 0.0:
        return float(min(best_radius, min_radius * 2.0))

    return float(best_radius)
